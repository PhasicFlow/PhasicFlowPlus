FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default                 none;
    div(alphaRhoPhi,U)      Gauss upwind;
    div(alphaRhoPhi,T)      Gauss upwind;

    // Transported species (YEqn.H); the inert N2 has no equation
    div(alphaRhoPhi,Y.CO)   Gauss upwind;
    div(alphaRhoPhi,Y.CO2)  Gauss upwind;

    div(((alpha*nuEff)*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}


