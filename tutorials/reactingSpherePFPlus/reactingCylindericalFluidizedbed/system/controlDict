FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
    version     2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     reactingSpherePFPlus;

startFrom       startTime;

// 0 - 0.25 s: settling (DEM only); 0.25 - 1 s: fluidized with N2;
// CO from 1 s (inlet table of Y.CO). The CO for full reduction of the bed
// enters in 5.2 s, but a particle needs about 35 s at the inlet CO (grain
// time plus pore diffusion), so the run shows the first 4 s of the
// reduction; raise endTime for a longer run.
startTime       0.25;

stopAt          endTime;

endTime         5;

deltaT          0.0005;

writeControl    adjustableRunTime;

writeInterval   0.1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

// Needed for the reaction limits of system/fvSolution/CLC: ReactionNo.H
// lowers deltaT only when adjustTimeStep is on.
adjustTimeStep  yes;

maxCo           0.5;

maxDeltaT       0.0005;

// Time series for the results (outlet gas, mean gas temperature), every
// 0.01 s, in postProcessing/. Flux-weighted average over the outlet patch.
functions
{
    outletGas
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeControl    adjustableRunTime;
        writeInterval   0.01;
        log             false;
        writeFields     false;
        regionType      patch;
        name            outlet;
        operation       weightedAreaAverage;
        weightField     phi;
        fields          (Y.CO Y.CO2 Y.N2 T);
    }

    bedGas
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        writeControl    adjustableRunTime;
        writeInterval   0.01;
        log             false;
        writeFields     false;
        regionType      all;
        operation       volAverage;
        fields          (T);
    }
}

