FoamFile
{
    format      ascii;
    class       volScalarField;
    object      Y.CO2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Mass fraction of CO2

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    outlet
    {
        type            zeroGradient;
    }
    cylinderWall
    {
        type            zeroGradient;
    }
}

// ************************************************************************* //
